{
  "title": "Basketball Stats",
  "uid": "basketball-stats",
  "version": 1,
  "timezone": "browser",
  "schemaVersion": 38,
  "tags": ["basketball", "flask"],
  "panels": [
    {
      "title": "Request Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "rate(flask_http_request_duration_seconds_count[1m])",
          "legendFormat": "{{method}} {{path}}",
          "intervalFactor": 2
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        }
      }
    },
    {
      "title": "Request Latency (p50 / p95 / p99)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(flask_http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(flask_http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(flask_http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      }
    },
    {
      "title": "HTTP Error Rate (5xx)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "sum(rate(flask_http_request_duration_seconds_count{status=~\"5..\"}[5m])) / sum(rate(flask_http_request_duration_seconds_count[5m]))",
          "legendFormat": "5xx ratio"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        }
      }
    },
    {
      "title": "Active Requests",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "flask_http_requests_active",
          "legendFormat": "active requests"
        }
      ]
    },
    {
      "title": "Log Volume by Level",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "datasource": "Loki",
      "targets": [
        {
          "expr": "rate({job=~\"docker-logs\"}[1m])",
          "legendFormat": "all"
        },
        {
          "expr": "rate({job=~\"docker-logs\"} |= `\"level\":\"ERROR\"` [1m])",
          "legendFormat": "ERROR"
        },
        {
          "expr": "rate({job=~\"docker-logs\"} |= `\"level\":\"WARNING\"` [1m])",
          "legendFormat": "WARN"
        }
      ]
    },
    {
      "title": "Recent Errors",
      "type": "logs",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 24 },
      "datasource": "Loki",
      "targets": [
        {
          "expr": "{service=~\"web_.*\"} |= `\"level\":\"ERROR\"`",
          "maxLines": 100
        }
      ]
    }
  ]
}
