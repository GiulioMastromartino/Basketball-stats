# Flask
SECRET_KEY=CHANGE_ME_use_openssl_rand_hex_32
FLASK_ENV=production
LOG_LEVEL=INFO
LOG_FILE=/dev/stdout
LOG_FORMAT=json
METRICS_ENABLED=True
# Schema migrations run in the one-shot `migrator` compose service. The web
# replicas must NOT migrate at boot: gunicorn preloads the app factory into
# the master process, so startup database work would leave a pooled
# connection behind for every forked worker to inherit.
AUTO_MIGRATE=False

# Database
DB_USER=basketball_user
DB_PASSWORD=CHANGE_ME_strong_password
DB_NAME=basketball_stats

# Cloudflare Tunnel token
CLOUDFLARE_TUNNEL_TOKEN=CHANGE_ME

# Admin bootstrap
ADMIN_EMAIL=admin@example.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_strong_admin_password

# Rate limiter (Redis required)
RATELIMIT_STORAGE_URL=redis://redis:6379/0

# WorkOS (SSO authentication)
WORKOS_API_KEY=CHANGE_ME
WORKOS_CLIENT_ID=CHANGE_ME
WORKOS_COOKIE_PASSWORD=CHANGE_ME_use_openssl_rand_base64_32
WORKOS_REDIRECT_URI=https://your-domain.com/auth/callback

# WorkOS (SSO authentication) — set these in /app/.env.prod on the server
WORKOS_API_KEY=CHANGE_ME
WORKOS_CLIENT_ID=CHANGE_ME
WORKOS_COOKIE_PASSWORD=CHANGE_ME_use_openssl_rand_base64_32
WORKOS_REDIRECT_URI=https://your-domain.com/auth/callback

# Google Drive per-user export sync (optional, no billing account needed).
# Each user links their own account; exported PDFs go to their own Drive and
# are never persisted on this server. Leave blank to disable the feature.
#
# GOOGLE_DRIVE_REDIRECT_URI must byte-for-byte match a redirect URI registered
# on the OAuth client. In production TLS terminates at the tunnel, so use the
# public HTTPS origin — never derive it from the incoming request.
GOOGLE_DRIVE_CLIENT_ID=CHANGE_ME.apps.googleusercontent.com
GOOGLE_DRIVE_CLIENT_SECRET=CHANGE_ME
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing this key means every user must re-link. Never commit it.
GOOGLE_DRIVE_TOKEN_KEY=CHANGE_ME
GOOGLE_DRIVE_REDIRECT_URI=https://your-domain.com/integrations/google/callback
GOOGLE_DRIVE_ROOT_FOLDER=HoopsLab

# Evolution API WhatsApp gateway (compose service name is `evolution`)
EVOLUTION_API_URL=http://evolution:8080
EVOLUTION_API_KEY=CHANGE_ME_strong_random_key
EVOLUTION_INSTANCE=basketball-bot

# App paths
GAMES_DIR=/app/Games
OUTPUT_DIR=/app/Output
UPLOAD_FOLDER=/app/uploads