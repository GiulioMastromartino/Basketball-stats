# Flask
SECRET_KEY=CHANGE_ME_use_openssl_rand_hex_32
FLASK_ENV=production
LOG_LEVEL=INFO
LOG_FILE=/dev/stdout
LOG_FORMAT=json
METRICS_ENABLED=True
AUTO_MIGRATE=False

# Database
DB_USER=basketball_user
DB_PASSWORD=CHANGE_ME_strong_password
DB_NAME=basketball_stats

# Cloudflare Tunnel token
CLOUDFLARE_TUNNEL_TOKEN=CHANGE_ME

# Admin bootstrap
ADMIN_EMAIL=admin@example.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_strong_admin_password

# Rate limiter (Redis required)
RATELIMIT_STORAGE_URL=redis://redis:6379/0

# WorkOS (SSO authentication)
WORKOS_API_KEY=CHANGE_ME
WORKOS_CLIENT_ID=CHANGE_ME
WORKOS_COOKIE_PASSWORD=CHANGE_ME_use_openssl_rand_base64_32
WORKOS_REDIRECT_URI=https://your-domain.com/auth/callback

# App paths
GAMES_DIR=/app/Games
OUTPUT_DIR=/app/Output
UPLOAD_FOLDER=/app/uploads