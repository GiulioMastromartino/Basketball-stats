# Flask configuration
FLASK_ENV=development
SECRET_KEY=your-secret-key-here

# Database
DATABASE_URL=sqlite:///basketball_stats.db
# For PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost/basketball_stats

# Directories
GAMES_DIR=Games
OUTPUT_DIR=Output
UPLOAD_FOLDER=uploads

# Cache
CACHE_TYPE=SimpleCache
CACHE_TIMEOUT=300

# Rate limiting
RATELIMIT_STORAGE_URL=memory://
RATELIMIT_STRATEGY=fixed-window
RATELIMIT_DEFAULT=200 per day;50 per hour
RATELIMIT_HEADERS_ENABLED=True
ROLLING_WINDOW=3

# Logging
LOG_LEVEL=INFO
LOG_FILE=basketball_stats.log
LOG_FORMAT=json          # "json" or "text"

# Metrics
METRICS_ENABLED=True

# WorkOS (for auth)
WORKOS_API_KEY=your_workos_api_key
WORKOS_CLIENT_ID=your_workos_client_id
WORKOS_COOKIE_PASSWORD=your_cookie_password
WORKOS_REDIRECT_URI=http://localhost:8080/auth/callback

# Google Drive per-user export sync (optional).
# One OAuth client serves every user; each user consents for their own Drive.
# No billing account is required and standard Drive API use is free.
# Leave any of these blank to disable the feature entirely (UI hidden, routes 404).
#
# Setup: console.cloud.google.com -> new project -> enable "Google Drive API"
# -> OAuth consent screen (type External) -> publish to PRODUCTION (NOT
# "Testing", or every refresh token expires after 7 days) -> create an OAuth
# client of type "Web application" -> add the redirect URI below verbatim.
GOOGLE_DRIVE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_DRIVE_CLIENT_SECRET=your_client_secret
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing this key means every user must re-link. Never commit it.
GOOGLE_DRIVE_TOKEN_KEY=
# Must byte-for-byte match a redirect URI registered on the OAuth client.
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:8080/integrations/google/callback
# Level-1 folder created in each user's Drive; teams nest beneath it.
GOOGLE_DRIVE_ROOT_FOLDER=HoopsLab

# Email (optional)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=

# Evolution API WhatsApp gateway (Baileys, self-hosted, pinned v2.3.7)
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=change-me-strong-random-key-here
EVOLUTION_INSTANCE=basketball-bot

# Application
TOP_SCORERS_LIMIT=10
DEFAULT_PAGE_SIZE=50
MAX_PAGE_SIZE=200