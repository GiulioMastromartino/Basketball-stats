<!-- ══ PDF ══ -->
<section class="section" id="reports">
  <div class="sec-label">Reports</div>
  <h2 class="sec-title">Professional reports,<br>one click away.</h2>
  <p class="sec-sub">Server-side PDF rendering — print-ready in seconds after saving a game.</p>
  <div class="pdf-grid">
    <div class="pdf-card"><div class="pdf-card__ico"><i class="fas fa-file-alt"></i></div><div class="pdf-card__name">Game Summary</div></div>
    <div class="pdf-card"><div class="pdf-card__ico"><i class="fas fa-clock"></i></div><div class="pdf-card__name">Halftime Summary</div></div>
    <div class="pdf-card"><div class="pdf-card__ico"><i class="fas fa-chart-line"></i></div><div class="pdf-card__name">Game Evolution</div></div>
    <div class="pdf-card"><div class="pdf-card__ico"><i class="fas fa-brain"></i></div><div class="pdf-card__name">Advanced Game Report</div></div>
