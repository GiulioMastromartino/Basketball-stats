<!-- ══ WORKFLOW ══ -->
<section class="section" id="workflow">
  <div class="sec-label">Workflow</div>
  <h2 class="sec-title">Up and running<br>in minutes.</h2>
  <p class="sec-sub">No complex setup. Start a live game, track stats, export reports.</p>
  <div class="steps">
    <div class="step"><div class="step__n c-acc">01</div><div class="step__title">Start a Game</div><div class="step__body">Create a game, configure your roster and playbook, then open the live tracking interface from any device.</div></div>
    <div class="step"><div class="step__n c-cool">02</div><div class="step__title">Track &amp; Tag</div><div class="step__body">Log shots, assists, rebounds, turnovers and fouls in real time. Tag each play with a named play from your playbook.</div></div>
    <div class="step"><div class="step__n c-gold">03</div><div class="step__title">Analyse</div><div class="step__body">Browse game dashboards, player profiles, opponent dossiers, lineup breakdowns, and advanced analytics.</div></div>
    <div class="step"><div class="step__n c-win">04</div><div class="step__title">Export &amp; Share</div><div class="step__body">Generate polished PDFs — halftime summaries, full game reports, player cards — and share instantly.</div></div>
  </div>
</section>

<div class="divider"></div>

<!-- ══ CTA ══ -->
<section class="cta-band">
  <div class="ring ring--1"></div>
  <div class="ring ring--2"></div>
  <div class="ring ring--3"></div>
  <h2 class="cta-band__title">Ready to see the<br>full picture?</h2>
  <p class="cta-band__sub">Sign in and start turning raw game data into coaching intelligence.</p>
  <a href="{{ url_for('auth.login') }}" class="btn-fire" style="font-size:1rem;padding:15px 38px">
    <i class="fas fa-sign-in-alt"></i> Sign in
  </a>
</section>

<footer>
  <span class="footer-logo">CourtIQ</span>
  <p>Basketball Analytics &copy; 2026</p>
</footer>

<!-- JS: mouse-parallax 3D card tilt -->
<script>
(function(){
  'use strict';
  const TILT = 12; // max degrees
  const LIFT = 22; // max px translateY on hover

  function tiltCard(card, e){
    const rect = card.getBoundingClientRect();
    const cx = rect.left + rect.width  / 2;
    const cy = rect.top  + rect.height / 2;
    const dx = (e.clientX - cx) / (rect.width  / 2);
    const dy = (e.clientY - cy) / (rect.height / 2);
    const rotX = -dy * TILT;
    const rotY =  dx * TILT;
    card.style.transform = `perspective(900px) rotateX(${rotX}deg) rotateY(${rotY}deg) translateY(-${LIFT*0.4}px)`;
    card.style.boxShadow = `${-rotY*2}px ${rotX*2+14}px 50px rgba(0,0,0,.55), 0 4px 18px rgba(0,0,0,.3)`;
  }

  function resetCard(card){
    card.style.transform = 'perspective(900px) rotateX(0deg) rotateY(0deg) translateY(0)';
    card.style.boxShadow = '';
  }

  document.querySelectorAll('[data-tilt]').forEach(card => {
    card.addEventListener('mousemove', e => tiltCard(card, e));
    card.addEventListener('mouseleave', () => resetCard(card));
    card.style.transition = 'transform .08s ease-out, box-shadow .08s ease-out, border-color .25s';
  });

  // mock3d mouse parallax
  document.querySelectorAll('.mock3d-wrap').forEach(wrap => {
    const inner = wrap.querySelector('.mock3d');
    if(!inner) return;
    wrap.addEventListener('mousemove', e => {
      const rect = wrap.getBoundingClientRect();
      const cx = rect.left + rect.width / 2;
      const cy = rect.top  + rect.height / 2;
      const dx = (e.clientX - cx) / (rect.width  / 2);
      const dy = (e.clientY - cy) / (rect.height / 2);
      inner.style.transform = `perspective(1000px) rotateX(${-dy*6}deg) rotateY(${dx*6}deg) scale(1)`;
    });
    wrap.addEventListener('mouseleave', () => {
      inner.style.transform = '';
    });
    inner.style.transition = 'transform .12s ease-out, box-shadow .3s';
  });
})();
</script>
</body>
</html>
